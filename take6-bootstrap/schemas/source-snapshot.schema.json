{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "take6:source-snapshot:0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repository",
    "commit",
    "tree_sha",
    "recursive_tree_truncated",
    "supersedes"
  ],
  "properties": {
    "repository": {"type": "string", "minLength": 1},
    "role": {"type": ["string", "null"]},
    "commit": {"type": "string", "minLength": 7},
    "tree_sha": {"type": "string", "minLength": 7},
    "recursive_tree_truncated": {"type": "boolean"},
    "entry_count": {"type": ["integer", "null"], "minimum": 0},
    "blob_count": {"type": ["integer", "null"], "minimum": 0},
    "inventory": {"type": ["string", "null"]},
    "supersedes": {
      "type": "array",
      "items": {"type": "string", "minLength": 7},
      "uniqueItems": true
    },
    "note": {"type": ["string", "null"]}
  }
}
