{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "take6:tool-capsule:0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tool_id",
    "spec_cid",
    "runtime_cid",
    "dependency_cids",
    "protected_behaviors",
    "equivalence_tests",
    "environment_contract"
  ],
  "properties": {
    "tool_id": {
      "type": "string",
      "minLength": 1
    },
    "spec_cid": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "runtime_cid": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "dependency_cids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "uniqueItems": true
    },
    "protected_behaviors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "equivalence_tests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "environment_contract": {
      "type": "object"
    },
    "open_coordinates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
